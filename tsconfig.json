{
  "compilerOptions": {
    "target": "ESNext", // Use modern JS
    "module": "ESNext", // Keep modules modern
    "moduleResolution": "Node", // Resolve modules like Node
    "jsx": "react-jsx", // Enable JSX support (React 17+)
    "esModuleInterop": true, // Fix default import issue
    "allowSyntheticDefaultImports": true, // Helps with React imports
    "strict": true, // Enable strict type-checking
    "skipLibCheck": true, // Skip checking node_modules
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "src",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "include": [
    "src",
    "src/__tests__"
  ], // Compile everything inside /src
  "exclude": [
    "node_modules",
    "dist"
  ] // Ignore build output
}