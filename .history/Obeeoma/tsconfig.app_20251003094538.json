{
  "compilerOptions": {
    "jsx": "react-jsx", // Enables JSX for React 17+
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".", // Needed for path aliasing
    "paths": {
      "@/*": ["src/*"] // Matches your root tsconfig
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.js"]
}
